  <metadata>
    <id>Linux.Bluetooth</id>
    <version>5.67.1</version>
    <title>Linux.Bluetooth - Linux Bluetooth LE library</title>
    <authors>Xeno Innovations</authors>
    <license type="expression">Apache-2.0</license>
