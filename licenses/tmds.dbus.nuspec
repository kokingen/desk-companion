<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Tmds.DBus</id>
    <version>0.95.1</version>
    <authors>Tom Deseyn</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>icon_128.png</icon>
    <readme>README.md</readme>
    <description>D-Bus library for .NET that uses reflection and runtime code generation</description>
    <copyright>Tom Deseyn;Alp Toker</copyright>
    <tags>dbus</tags>
    <repository type="git" url="https://github.com/tmds/Tmds.DBus.git" branch="refs/heads/main" commit="491bde2c16d65a7904397933cffa24e15e45eb2a" />
    <dependencies>
      <group targetFramework="net6.0" />
      <group targetFramework=".NETStandard2.0">
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="8.0.0" exclude="Build,Analyzers" />
        <dependency id="System.Reflection.Emit" version="4.7.0" exclude="Build,Analyzers" />
        <dependency id="System.Security.Principal.Windows" version="5.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>