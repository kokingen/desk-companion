<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DeskCompanionAgent</AssemblyName>
    <Version>0.3.1</Version>
    <Product>Desk Companion</Product>
    <Title>Desk Companion Agent</Title>
    <Authors>Desk Companion contributors</Authors>
    <Company>Desk Companion contributors</Company>
    <DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)'=='Release'">false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../PhoneBox.Agent/Lan.cs" Link="PhoneBox/Lan.cs" />
    <Compile Include="../PhoneBox.Agent/Pairing.cs" Link="PhoneBox/Pairing.cs" />
    <Compile Include="../PhoneBox.Agent/AppPaths.cs" Link="PhoneBox/AppPaths.cs" />
    <Compile Include="../PhoneBox.Agent/SessionMonitor.cs" Link="PhoneBox/SessionMonitor.cs" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="InTheHand.Net.Bluetooth" Version="4.2.5" />
    <EmbeddedResource Include="pairing.html" />
  </ItemGroup>
</Project>
