# Generic short FPS/frame-timeline capture. Run with an external official Perfetto binary.
# The atrace app filter uses the legacy companion package id for compatibility; adjust it
# if you measure a differently branded build.
buffers { size_kb: 8192 fill_policy: RING_BUFFER }
data_sources { config { name: "android.surfaceflinger.frametimeline" } }
data_sources { config { name: "linux.process_stats" process_stats_config { scan_all_processes_on_start: true } } }
data_sources { config { name: "linux.ftrace" ftrace_config { ftrace_events: "ftrace/print" atrace_apps: "net.oxog.phonebox.deskpanel.max3" } } }
duration_ms: 70000
write_into_file: true
file_write_period_ms: 1000
max_file_size_bytes: 33554432
